#!/bin/sh

# flannel
kubectl create ns kube-flannel
kubectl label --overwrite ns kube-flannel pod-security.kubernetes.io/enforce=privileged
helm repo add flannel https://flannel-io.github.io/flannel/
helm upgrade --install flannel flannel/flannel \
  --set podCidr="{{ k8s_pod_network_cidr }}" \
  --wait \
  --timeout 5m \
  --namespace kube-flannel

# csr auto apporver
helm repo add kubelet-csr-approver https://postfinance.github.io/kubelet-csr-approver
helm upgrade --install kubelet-csr-approver kubelet-csr-approver/kubelet-csr-approver \
  --set providerIpPrefixes='{{ k8s_nodes_network }}' \
  --set maxExpirationSeconds='86400' \
  --set bypassDnsResolution='true' \
  --wait \
  --timeout 5m \
  --namespace kube-system

# argocd
kubectl create namespace argocd
helm repo add argo https://argoproj.github.io/argo-helm
helm upgrade --install argocd argo/argo-cd \
  --set configs.params."server\.insecure"=true \
  --set server.service.type=ClusterIP \
  --wait \
  --timeout 5m \
  --namespace argocd

kubectl apply -f {{ playbook_dir }}/bootstrap/argocd-root-app.yaml
